# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# ─────────────────────────────────────────────────────────────
# LLM provider — swappable by configuration (M15). The agent code
# never hard-codes a provider; it reads these values at startup.
# ─────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini                 # gemini | groq | openrouter | stub
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=                        # your free-tier key
LLM_BASE_URL=                       # optional OpenAI-compatible endpoint
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# For CI and the eval harness use the deterministic offline stub:
#   LLM_PROVIDER=stub

# ─────────────────────────────────────────────────────────────
# Autonomy thresholds — externally configurable (M13 / F7).
# CEILING is the absolute envelope; per-category tiers (travel 500,
# hardware 350, meals 250, saas 200, other 100) are served via Dapr
# config and are always clamped by the envelope. See PRODUCT-DILEMMA.md.
# ─────────────────────────────────────────────────────────────
AUTONOMY_CEILING_USD=500
AUTONOMY_CONFIDENCE=0.80

# ─────────────────────────────────────────────────────────────
# Security — self-signed JWT with roles (N1).
# ─────────────────────────────────────────────────────────────
# At least 32 bytes for HS256.
JWT_SECRET=change-me-dev-only-secret-0123456789abcdef
JWT_ISSUER=approvalflow
JWT_AUDIENCE=approvalflow

# ─────────────────────────────────────────────────────────────
# Infrastructure (defaults match docker-compose service names).
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=approvalflow
POSTGRES_PASSWORD=approvalflow
REDIS_HOST=redis:6379

# ─────────────────────────────────────────────────────────────
# Observability (N4)
# ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=approvalflow
